{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowJs": false,
    "checkJs": false,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@varka/database": ["packages/database/src/index.ts"],
      "@varka/auth": ["packages/auth/src/index.ts"],
      "@varka/config": ["packages/config/src/index.ts"],
      "@varka/types": ["packages/types/src/index.ts"],
      "@varka/validation": ["packages/validation/src/index.ts"],
      "@varka/permissions": ["packages/permissions/src/index.ts"],
      "@varka/api": ["packages/api/src/index.ts"],
      "@varka/content": ["packages/content/src/index.ts"],
      "@varka/seo": ["packages/seo/src/index.ts"],
      "@varka/i18n": ["packages/i18n/src/index.ts"],
      "@varka/media": ["packages/media/src/index.ts"],
      "@varka/markdown": ["packages/markdown/src/index.ts"],
      "@varka/cache": ["packages/cache/src/index.ts"],
      "@varka/queue": ["packages/queue/src/index.ts"],
      "@varka/ui": ["packages/ui/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next", ".astro"]
}
