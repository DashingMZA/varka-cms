diff --git a/apps/web/src/celebrtiy/components/BreadcrumbHero.astro b/apps/web/src/celebrtiy/components/BreadcrumbHero.astro
new file mode 100644
index 0000000..70ed355
--- /dev/null
+++ b/apps/web/src/celebrtiy/components/BreadcrumbHero.astro
@@ -0,0 +1,26 @@
+---
+interface Crumb {
+  label: string;
+  href?: string;
+}
+
+interface Props {
+  crumbs: Crumb[];
+  title: string;
+}
+
+const { crumbs, title } = Astro.props;
+---
+<div class="celebrtiy-hero-band">
+  <div class="celebrtiy-container">
+    <nav class="celebrtiy-breadcrumbs" aria-label="Breadcrumb">
+      {crumbs.map((c, i) => (
+        <>
+          {i > 0 ? <span class="sep">»</span> : null}
+          {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
+        </>
+      ))}
+    </nav>
+    <h1 class="celebrtiy-hero-title">{title}</h1>
+  </div>
+</div>
diff --git a/apps/web/src/celebrtiy/components/CardRow.astro b/apps/web/src/celebrtiy/components/CardRow.astro
new file mode 100644
index 0000000..8a0a7a4
--- /dev/null
+++ b/apps/web/src/celebrtiy/components/CardRow.astro
@@ -0,0 +1,29 @@
+---
+import PostCard from './PostCard.astro';
+import type { CelebrtiyPostCard } from '../lib/data';
+
+interface Props {
+  title: string;
+  posts: CelebrtiyPostCard[];
+  link?: { label: string; href: string };
+}
+
+const { title, posts, link } = Astro.props;
+---
+{posts.length > 0 ? (
+  <section class="celebrtiy-section">
+    <div class="celebrtiy-container">
+      <h2 class="celebrtiy-section-title">{title}</h2>
+      <div class="celebrtiy-card-row">
+        {posts.slice(0, 4).map((p) => (
+          <PostCard post={p} />
+        ))}
+      </div>
+      {link ? (
+        <p style="margin-top:1.5rem;">
+          <a class="celebrtiy-card-link" href={link.href}>{link.label} →</a>
+        </p>
+      ) : null}
+    </div>
+  </section>
+) : null}
