{
  "name": "@varka/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "migrate:dev:name": "prisma migrate dev --name",
    "db:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo lint:@varka/database",
    "build": "echo build:@varka/database"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "dotenv": "^16.6.1",
    "prisma": "7.10.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
