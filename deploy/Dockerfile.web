# VARKA Public (Astro static) — nginx serve
FROM node:22-alpine AS build
RUN corepack enable && corepack prepare pnpm@11.27.0 --activate
WORKDIR /app
ARG PUBLIC_SITE_URL=http://localhost:4321
ARG PUBLIC_API_URL=http://localhost:3000
ARG PUBLIC_SITE_NAME=VARKA
ARG PUBLIC_THEME_ID=theme-01
ENV PUBLIC_SITE_URL=$PUBLIC_SITE_URL
ENV PUBLIC_API_URL=$PUBLIC_API_URL
ENV PUBLIC_SITE_NAME=$PUBLIC_SITE_NAME
ENV PUBLIC_THEME_ID=$PUBLIC_THEME_ID
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* .npmrc* ./
COPY apps/web/package.json apps/web/
COPY packages/themes/package.json packages/themes/
COPY packages/seo/package.json packages/seo/
COPY packages/i18n/package.json packages/i18n/
RUN pnpm install --frozen-lockfile || pnpm install
COPY . .
RUN pnpm --filter @varka/web build

FROM nginx:1.27-alpine AS runner
COPY deploy/nginx-web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 4321
# nginx listens 80 inside; map host 4321:80 in compose if needed — use custom conf port
