# VARKA Public (Astro SSR via @astrojs/node) — Node runtime
FROM node:24-alpine AS base
RUN corepack enable && corepack prepare pnpm@12.4.2 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* .npmrc* ./
COPY apps/web/package.json apps/web/
COPY packages/themes/package.json packages/themes/
COPY packages/seo/package.json packages/seo/
COPY packages/i18n/package.json packages/i18n/
RUN pnpm install --frozen-lockfile || pnpm install

FROM base AS build
ARG PUBLIC_SITE_URL=http://localhost:4321
ARG PUBLIC_API_URL=http://localhost:3000
ARG PUBLIC_SITE_NAME=VARKA
ARG PUBLIC_THEME_ID=theme-01
ENV PUBLIC_SITE_URL=$PUBLIC_SITE_URL
ENV PUBLIC_API_URL=$PUBLIC_API_URL
ENV PUBLIC_SITE_NAME=$PUBLIC_SITE_NAME
ENV PUBLIC_THEME_ID=$PUBLIC_THEME_ID
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps ./apps
COPY --from=deps /app/packages ./packages
COPY . .
RUN pnpm --filter @varka/web build

FROM node:24-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=4321
RUN addgroup -g 1001 -S varka && adduser -S varka -u 1001
# Astro node standalone: dist/server/entry.mjs + client assets
COPY --from=build /app/apps/web/dist ./dist
COPY --from=build /app/apps/web/package.json ./package.json
# runtime deps for SSR entry (astro node adapter needs node_modules subset)
COPY --from=build /app/node_modules ./node_modules
USER varka
EXPOSE 4321
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD wget -qO- http://127.0.0.1:4321/ || exit 1
CMD ["node", "./dist/server/entry.mjs"]
