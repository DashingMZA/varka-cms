# VARKA — environment template (copy to .env — never commit real secrets)

# Database (Prisma / PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/varka?sslmode=require"

# Auth (Better Auth) — REQUIRED in production (≥32 random chars)
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3000"
SITE_URL="http://localhost:4321"
AUTH_APP_NAME="VARKA"
# Set true to require email verification before sign-in (default true in production)
AUTH_REQUIRE_EMAIL_VERIFICATION="false"

# Optional OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Email delivery for OTP / verify / reset / 2FA
# Preferred: webhook (Resend, Postmark, custom) — no nodemailer dependency
EMAIL_WEBHOOK_URL=""
EMAIL_WEBHOOK_TOKEN=""
EMAIL_FROM="noreply@example.com"
SMTP_FROM="noreply@example.com"
# Optional legacy SMTP fields (unused when webhook is set)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"

# Redis (cache / rate-limit) — optional; memory fallback if unset
REDIS_URL=""

# Media storage
# ---------------------------------------------------------------------------
# Switch drivers by changing ONE value: STORAGE_DRIVER=local|s3|r2
# (The admin dashboard at Settings → Media can also override this via the
# `media.storage_driver` setting — DB wins over env, no redeploy needed.)
#
# Each driver has its OWN variables — set them all once, then only flip
# STORAGE_DRIVER to switch.
#
# local: files saved to LOCAL_STORAGE_PATH (default ./public/uploads in the
#   admin app, served statically at /uploads/<key>). On Vercel the filesystem
#   is ephemeral — use s3/r2 for persistent media.
STORAGE_DRIVER="local"

# --- Local driver ---
LOCAL_STORAGE_PATH="./public/uploads"
LOCAL_PUBLIC_URL="/uploads"

# --- Amazon S3 driver (STORAGE_DRIVER=s3) ---
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public URL prefix for stored files, e.g. https://my-bucket.s3.amazonaws.com
# or a CloudFront URL. Falls back to MEDIA_PUBLIC_URL if empty.
S3_PUBLIC_URL=""
# Optional: custom endpoint (for S3-compatible services) + path-style toggle
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"

# --- Cloudflare R2 driver (STORAGE_DRIVER=r2) ---
R2_BUCKET=""
# e.g. https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Public URL prefix, e.g. https://pub-xxxx.r2.dev or https://cdn.example.com
R2_PUBLIC_URL=""

# Legacy fallback for the public URL prefix (used if the driver-specific
# *_PUBLIC_URL above is empty)
MEDIA_PUBLIC_URL="/uploads"

# Security headers / CSP (optional overrides)
CSP_REPORT_ONLY="false"

# Node
NODE_ENV="development"
