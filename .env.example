# =============================================================================
# VARKA — environment example
# Copy to `.env` (or `.env.local`) and fill values. Never commit real secrets.
# =============================================================================

# Database (Prisma)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require

# App URLs
SITE_URL=http://localhost:4321
ADMIN_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# =============================================================================
# Auth / security (Better Auth)
# =============================================================================
# Required in production: random string ≥ 32 characters
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# BETTER_AUTH_SECRET=  # alias for AUTH_SECRET
AUTH_APP_NAME=VARKA
# Force email verification before sign-in (also forced when NODE_ENV=production)
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Argon2id (optional tuning)
# AUTH_ARGON2_MEMORY_KIB=19456
# AUTH_ARGON2_TIME_COST=2
# AUTH_ARGON2_PARALLELISM=1

# Email delivery (optional)
# Without EMAIL_WEBHOOK_URL, codes/links are logged to the server console (dev).
# EMAIL_WEBHOOK_URL=https://api.resend.com/emails
# EMAIL_WEBHOOK_TOKEN=
# SMTP_FROM=noreply@example.com
# EMAIL_FROM=noreply@example.com

# OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Redis (optional — memory fallback if unset)
REDIS_URL=

# Storage
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=.storage

# S3 / R2 (when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

MEDIA_MAX_BYTES=26214400
MEDIA_PUBLIC_URL=/api/media/file
MEDIA_CDN_URL=
MEDIA_CACHE_MAX_AGE=31536000
MEDIA_CORP=cross-origin
MEDIA_THUMB_WIDTH=150
MEDIA_THUMB_HEIGHT=150
MEDIA_MEDIUM_WIDTH=300
MEDIA_MEDIUM_HEIGHT=300
MEDIA_LARGE_WIDTH=1024
MEDIA_LARGE_HEIGHT=1024
MEDIA_WEBP_QUALITY_THUMB=75
MEDIA_WEBP_QUALITY=82

# Themes
THEME_LOCKED=
DEFAULT_THEME=theme-01
ALLOW_DEV_AUTH_FALLBACK=false
