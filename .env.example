# =============================================================================
# VARKA — environment example
# Copy to `.env` (or `.env.local`) and fill values. Never commit real secrets.
# =============================================================================

NODE_ENV=development

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://varka:varka@localhost:5432/varka?schema=public

# -----------------------------------------------------------------------------
# Redis / cache (optional locally; recommended for multi-instance + rate limits)
# -----------------------------------------------------------------------------
# Leave empty to use in-memory cache (single process only — NOT for production cluster)
REDIS_URL=redis://localhost:6379
# CACHE_DRIVER=memory | redis   (auto: redis if REDIS_URL set)
CACHE_DRIVER=

# -----------------------------------------------------------------------------
# Auth secrets (required in production)
# Generate: openssl rand -base64 48
# AUTH_SECRET must be ≥32 random chars; placeholders refused in production
# -----------------------------------------------------------------------------
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me-strong-password

AUTH_REQUIRE_EMAIL_VERIFICATION=false

AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1

AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_WINDOW_SEC=60

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Public site + admin origins
# -----------------------------------------------------------------------------
SITE_URL=http://localhost:4321
ADMIN_URL=http://localhost:3000
ADMIN_SUBDOMAIN=adminzb

PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_SITE_NAME=VARKA
PUBLIC_THEME_ID=theme-01
PUBLIC_API_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Content Security Policy
# -----------------------------------------------------------------------------
CSP_ALLOW_UNSAFE_EVAL=false
CSP_NONCE_ENABLED=true
CSP_REPORT_ONLY=false

# -----------------------------------------------------------------------------
# Media storage
# -----------------------------------------------------------------------------
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=.storage

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

MEDIA_MAX_BYTES=26214400
MEDIA_PUBLIC_URL=/api/media/file
MEDIA_CDN_URL=
MEDIA_CACHE_MAX_AGE=31536000
MEDIA_CORP=cross-origin
MEDIA_THUMB_WIDTH=150
MEDIA_THUMB_HEIGHT=150
MEDIA_MEDIUM_WIDTH=300
MEDIA_MEDIUM_HEIGHT=300
MEDIA_LARGE_WIDTH=1024
MEDIA_LARGE_HEIGHT=1024
MEDIA_WEBP_QUALITY_THUMB=75
MEDIA_WEBP_QUALITY=82

THEME_LOCKED=
DEFAULT_THEME=theme-01


ALLOW_DEV_AUTH_FALLBACK=false
