# VARKA environment example — copy to .env and fill values.
# Never commit .env

NODE_ENV=development

# PostgreSQL (required)
DATABASE_URL=postgresql://varka:varka@localhost:5432/varka?schema=public

# Redis (optional; required for production cache/queues)
REDIS_URL=redis://localhost:6379
CACHE_DRIVER=memory

# Auth — min 32 chars in production
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me-strong-password

# Allow owner-like API context without session (local / first deploy only)
# Set to false once Better Auth login works in production
ALLOW_DEV_AUTH_FALLBACK=true

# Public site + admin origins
SITE_URL=http://localhost:4321
ADMIN_URL=http://localhost:3000
ADMIN_SUBDOMAIN=adminzb
BETTER_AUTH_URL=http://localhost:3000

# Media storage: local | s3
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=.storage

# S3 / R2 (required when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Public base URL for objects (Cloudflare R2 custom domain, CloudFront, etc.)
# When set, media URLs use this instead of /api/media/file/…
# Example: https://cdn.example.com or https://pub-xxxx.r2.dev
MEDIA_CDN_URL=
# Optional path prefix on the CDN (e.g. /media)
MEDIA_CDN_PREFIX=

# Image derivatives (WebP) quality — higher = larger files, better quality
# thumbnail default 75 · medium/large default 80 · range 40–100
MEDIA_WEBP_QUALITY_THUMB=75
MEDIA_WEBP_QUALITY=80

# OAuth (optional — leave empty to disable provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Theme
THEME_LOCKED=
DEFAULT_THEME=theme-01

# Public Astro
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_SITE_NAME=VARKA
PUBLIC_THEME_ID=theme-01

# Astro → admin public API (legacy; public site prefers direct DB)
PUBLIC_API_URL=http://localhost:3000
