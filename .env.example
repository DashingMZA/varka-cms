# =============================================================================
# VARKA — environment template
# Copy to .env and fill in real values. NEVER commit .env with real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL via Prisma) — REQUIRED
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/varka?sslmode=require"

# -----------------------------------------------------------------------------
# Auth & Security — REQUIRED in production
# -----------------------------------------------------------------------------
# ≥32 random chars. Generate: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Password hashing (Argon2id) — OWASP recommended defaults, tune to your CPU
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1

# Login brute-force protection
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_WINDOW_SEC=60

# Require email verification before sign-in (default true in production)
AUTH_REQUIRE_EMAIL_VERIFICATION="false"
AUTH_APP_NAME="VARKA"

# Dev only: allow auth fallback when Better Auth misconfigured (never in prod)
# ALLOW_DEV_AUTH_FALLBACK="false"

# Optional OAuth providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Content Security Policy
# -----------------------------------------------------------------------------
CSP_ALLOW_UNSAFE_EVAL=false
CSP_NONCE_ENABLED=true
CSP_REPORT_ONLY=false

# -----------------------------------------------------------------------------
# Email delivery (OTP / verify / reset / 2FA)
# Preferred: webhook (Resend, Postmark, custom) — no nodemailer dependency
# -----------------------------------------------------------------------------
EMAIL_WEBHOOK_URL=""
EMAIL_WEBHOOK_TOKEN=""
EMAIL_FROM="noreply@example.com"
# Resend (API-based email, alternative to SMTP)
RESEND_API_KEY=""
# SMTP fallback (used when database SMTP is not configured)
SMTP_FROM="noreply@example.com"
SMTP_FROM_NAME="VARKA"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# SMTP_SECURE: true for port 465 (SSL), false for port 587 (STARTTLS)
SMTP_SECURE="false"

# -----------------------------------------------------------------------------
# Site URLs — admin + public (SEO: canonical URLs, sitemaps, OG tags)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:4321"

# -----------------------------------------------------------------------------
# Media storage — switch drivers by changing ONE value
# STORAGE_DRIVER=local|s3|r2|github
# (Admin: Settings → Media can override via `media.storage_driver` — DB wins
# over env, no redeploy needed. Credentials stay here in .env.)
#
# local:  ./public/uploads served at /uploads/<key>. Ephemeral on Vercel —
#         use s3/r2 for persistent media in production.
# github: SMALL sites only (portfolio/single-page) — every upload = git commit.
# -----------------------------------------------------------------------------
STORAGE_DRIVER="local"

# --- Local driver ---
LOCAL_STORAGE_PATH="./public/uploads"
LOCAL_PUBLIC_URL="/uploads"

# --- Amazon S3 driver (STORAGE_DRIVER=s3) ---
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public URL prefix, e.g. https://my-bucket.s3.amazonaws.com or CloudFront URL.
# Falls back to MEDIA_PUBLIC_URL if empty.
S3_PUBLIC_URL=""
# Optional: custom endpoint (S3-compatible services) + path-style toggle
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"

# --- Cloudflare R2 driver (STORAGE_DRIVER=r2) ---
R2_BUCKET=""
# e.g. https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Public URL prefix, e.g. https://pub-xxxx.r2.dev or https://cdn.example.com
R2_PUBLIC_URL=""

# --- GitHub driver (STORAGE_DRIVER=github) ---
# PAT: GitHub → Settings → Developer settings → Personal access tokens →
# Fine-grained token with Contents: Read+Write on the target repo.
GITHUB_TOKEN=""
# e.g. DashingMZA/my-portfolio
GITHUB_REPO=""
GITHUB_BRANCH="main"
# Folder inside the repo where files are stored
GITHUB_PATH_PREFIX="public/uploads"
# Recommended (CDN, fast):
#   https://cdn.jsdelivr.net/gh/<owner>/<repo>@<branch>/<prefix>
# Alternative (no CDN):
#   https://raw.githubusercontent.com/<owner>/<repo>/<branch>/<prefix>
GITHUB_PUBLIC_URL=""

# -----------------------------------------------------------------------------
# Media processing & delivery
# -----------------------------------------------------------------------------
# Max upload size in bytes (25 MB default)
MEDIA_MAX_BYTES=26214400
# Public URL prefix for media files (legacy fallback if driver URL empty)
MEDIA_PUBLIC_URL="/uploads"
# Optional CDN base URL prepended to media URLs (e.g. https://cdn.example.com)
MEDIA_CDN_URL=""
# Cache-Control max-age for served media (1 year default)
MEDIA_CACHE_MAX_AGE=31536000
# Cross-Origin-Resource-Policy for media responses
MEDIA_CORP="cross-origin"

# Responsive image sizes (px)
MEDIA_THUMB_WIDTH=150
MEDIA_THUMB_HEIGHT=150
MEDIA_MEDIUM_WIDTH=300
MEDIA_MEDIUM_HEIGHT=300
MEDIA_LARGE_WIDTH=1024
MEDIA_LARGE_HEIGHT=1024
# WebP output quality (0-100)
MEDIA_WEBP_QUALITY_THUMB=75
MEDIA_WEBP_QUALITY=82

# -----------------------------------------------------------------------------
# Plugins — override the directory scanned for installed plugins
# (default: <admin-app>/plugins)
# -----------------------------------------------------------------------------
# PLUGIN_DIR=""

# -----------------------------------------------------------------------------
# Redis (cache / rate-limit) — optional; in-memory fallback if unset
# -----------------------------------------------------------------------------
REDIS_URL=""

# -----------------------------------------------------------------------------
# Public website (Astro) — SEO & branding
# These PUBLIC_* vars are exposed to the browser build.
# -----------------------------------------------------------------------------
PUBLIC_SITE_URL="http://localhost:4321"
PUBLIC_SITE_NAME="VARKA"
PUBLIC_THEME_ID="theme-11"
PUBLIC_API_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Node
# -----------------------------------------------------------------------------
NODE_ENV="development"
