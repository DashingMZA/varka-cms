---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { fetchPostBySlug, fetchPublishedPosts } from '../../../lib/content-api';

export async function getStaticPaths() {
  const posts = await fetchPublishedPosts(100);
  const pa = posts.filter((p) => p.locale === 'pa');
  const paths = pa.map((p) => ({ params: { slug: p.slug } }));
  if (paths.length === 0) {
    return [{ params: { slug: 'placeholder' } }];
  }
  return paths;
}

const { slug } = Astro.params;
const post = slug ? await fetchPostBySlug(String(slug)) : null;
const title = post?.seoTitle || post?.title || String(slug);
const description = post?.seoDescription || post?.excerpt || '';
const path = post?.path || `/pa/post/${slug}`;
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  type="article"
  locale="pa"
>
  <article dir="rtl" lang="pa">
    <h1 class="post-title">{post?.title || slug}</h1>
    <p class="post-meta">{path}</p>
    {post ? (
      <div class="prose" set:html={post.contentHtml} />
    ) : (
      <div class="prose">
        <p>Post not found (locale pa). Publish a Punjabi translation in admin.</p>
      </div>
    )}
  </article>
</BaseLayout>
