---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommentSection from '../../components/CommentSection.astro';
import { fetchPostBySlug, fetchComments } from '../../lib/content-api';
import { postPath } from '@varka/i18n';

// Dynamic SSR — new published slugs work without rebuild
export const prerender = false;

Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=60, stale-while-revalidate=300',
);

const { slug } = Astro.params;
const post = slug ? await fetchPostBySlug(String(slug)) : null;

if (!post && slug) {
  Astro.response.status = 404;
}

const title = post?.seoTitle || post?.title || String(slug);
const description = post?.seoDescription || post?.excerpt || '';
const path =
  post?.path ||
  postPath({ defaultLanguage: true, locale: 'en', urlPrefix: '' }, String(slug ?? ''));
const comments = post ? await fetchComments(post.id) : [];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  type="article"
  locale={post?.locale || 'en'}
>
  <article>
    <h1 class="post-title">{post?.title || slug}</h1>
    <p class="post-meta">
      {path}
      {post?.publishedAt ? ` · ${new Date(post.publishedAt).toLocaleDateString()}` : ''}
    </p>
    {post ? (
      <div class="prose" set:html={post.contentHtml} />
    ) : (
      <div class="prose">
        <p>Post not found. Publish it in admin or check PUBLIC_API_URL.</p>
      </div>
    )}
  </article>
  {post ? <CommentSection postId={post.id} comments={comments} /> : null}
</BaseLayout>
