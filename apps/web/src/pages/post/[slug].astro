---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchPostBySlug, fetchPublishedPosts } from '../../lib/content-api';
import { postPath } from '@varka/i18n';

export async function getStaticPaths() {
  const posts = await fetchPublishedPosts(100);
  const paths = posts.map((p) => ({ params: { slug: p.slug } }));
  if (paths.length === 0) {
    return [{ params: { slug: 'hello-world' } }];
  }
  return paths;
}

const { slug } = Astro.params;
const post = slug ? await fetchPostBySlug(String(slug)) : null;
const title = post?.seoTitle || post?.title || String(slug);
const description = post?.seoDescription || post?.excerpt || '';
const path = post?.path || postPath({ defaultLanguage: true, locale: 'en', urlPrefix: '' }, String(slug));
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  type="article"
  locale={post?.locale || 'en'}
>
  <article>
    <h1 class="post-title">{post?.title || slug}</h1>
    <p class="post-meta">
      {path}
      {post?.publishedAt ? ` · ${new Date(post.publishedAt).toLocaleDateString()}` : ''}
    </p>
    {post ? (
      <div class="prose" set:html={post.contentHtml} />
    ) : (
      <div class="prose">
        <p>Post not found in API. Publish it in admin or check PUBLIC_API_URL.</p>
      </div>
    )}
  </article>
</BaseLayout>
